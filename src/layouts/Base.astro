---
/**
 * Layout base: SEO de cada página (CLAUDE.md § SEO y GEO) — title, description, canónica, hreflang recíproco + x-default,
 * Open Graph y JSON-LD base (Organization + WebSite). La página agrega su propio JSON-LD con `jsonld`.
 */
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import type { Seccion } from '../i18n/comun';
import { LOCALE, ruta, type ClaveRuta, type Idioma } from '../i18n/rutas';

interface Props {
  idioma: Idioma;
  clave: ClaveRuta;
  /** ≤ 60 caracteres. */
  titulo: string;
  /** ≤ 155 caracteres. */
  descripcion: string;
  activo?: Seccion;
  bandaPie?: boolean;
  jsonld?: Record<string, unknown>[];
  /** Páginas que todavía no se publican (corredores sin datos verificados). */
  noindex?: boolean;
}
const { idioma, clave, titulo, descripcion, activo, bandaPie = true, jsonld = [], noindex = false } = Astro.props;
const sitio = Astro.site!;
const absoluta = (p: string) => new URL(p, sitio).href;
const canonica = absoluta(ruta(clave, idioma));
const og = absoluta('/og-predeterminada.png');

const organizacion = {
  '@type': 'Organization',
  '@id': absoluta('/#organizacion'),
  name: 'Avanza Freight TMS',
  url: absoluta('/'),
  logo: absoluta('/marca/avanza-icono.svg'),
  areaServed: [
    { '@type': 'Country', name: 'Mexico' },
    { '@type': 'Country', name: 'United States' },
  ],
  address: { '@type': 'PostalAddress', addressLocality: 'Tijuana', addressRegion: 'B.C.', addressCountry: 'MX' },
};
const sitioWeb = {
  '@type': 'WebSite',
  '@id': absoluta('/#sitio'),
  name: 'Avanza',
  url: absoluta('/'),
  inLanguage: ['es-MX', 'en-US'],
  publisher: { '@id': organizacion['@id'] },
};
const grafo = { '@context': 'https://schema.org', '@graph': [organizacion, sitioWeb, ...jsonld] };
---
<!doctype html>
<html lang={LOCALE[idioma]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" hreflang="es-MX" href={absoluta(ruta(clave, 'es'))} />
    <link rel="alternate" hreflang="en-US" href={absoluta(ruta(clave, 'en'))} />
    <link rel="alternate" hreflang="x-default" href={absoluta(ruta(clave, 'es'))} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0F1B2D" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Avanza" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content={LOCALE[idioma].replace('-', '_')} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(grafo)} />
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <header class="bg-marino text-white">
      <div class="contenedor">
        <Nav idioma={idioma} clave={clave} activo={activo} />
      </div>
    </header>
    <main>
      <slot />
    </main>
    <Footer idioma={idioma} banda={bandaPie} />
  </body>
</html>
