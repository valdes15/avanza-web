---
import Base from '../../layouts/Base.astro';
import Inicio from '../../components/Inicio.astro';
import { INICIO } from '../../i18n/inicio';
import { aplicacionJsonLd, faqJsonLd } from '../../lib/jsonld';
const t = INICIO.en;
---
<Base idioma="en" clave="inicio" titulo={t.meta.titulo} descripcion={t.meta.descripcion} bandaPie={false} jsonld={[aplicacionJsonLd('en', t.meta.descripcion), faqJsonLd(t.preguntas.lista)]}>
  <Inicio idioma="en" />
</Base>
