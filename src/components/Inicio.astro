---
/**
 * La página de inicio, una sola para los dos idiomas: la estructura de Main.dc.html (ES) y HomeEN.dc.html (EN) es la misma
 * y solo cambia la copia (src/i18n/inicio.ts). En escritorio respeta el lienzo de 1440; en móvil, una columna.
 */
import Simbolo from './Simbolo.astro';
import Icono from './Icono.astro';
import Preguntas from './Preguntas.astro';
import { INICIO } from '../i18n/inicio';
import { ruta, urlDemo, type Idioma } from '../i18n/rutas';
interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const t = INICIO[idioma];
const h = t.heroe;
const empezar = urlDemo(idioma);
const burbuja = 'max-w-[300px] px-3.5 py-2.5 text-[15px] leading-[1.4]';
const hora = 'font-mono ml-1.5 text-[11px] text-sobre-marino-3';
---
<!-- Héroe: continúa el marino del encabezado -->
<section class="bg-marino text-white">
  <div class="contenedor grid items-center gap-12 pt-8 pb-16 lg:min-h-[732px] lg:grid-cols-2 lg:gap-16 lg:py-0">
    <div class="flex flex-col gap-6 lg:gap-7">
      <div class="etiqueta text-naranja text-[13px] lg:text-[14px]">{h.categoria}</div>
      <h1 class="font-titulo m-0 text-[38px] leading-[1.08] font-bold tracking-[-0.02em] sm:text-[48px] lg:text-[60px]">{h.titular}</h1>
      <p class="text-sobre-marino m-0 max-w-[540px] text-[18px] leading-[1.55] lg:text-[20px]">{h.bajada}</p>
      <div class="flex flex-wrap items-center gap-4">
        <a href={empezar} class="boton boton-principal h-14 px-7 text-[17px]">{INICIO[idioma].cierre.boton}</a>
        <a href={`#${h.anclaComoFunciona}`} class="boton boton-secundario-oscuro h-14 px-7 text-[17px]">{h.comoFunciona}</a>
      </div>
      <div class="text-sobre-marino-2 text-[14px]">{h.nota}</div>
    </div>

    <div class="flex justify-center">
      <div class="bg-marino-2 border-marino-borde flex w-full max-w-[460px] flex-col gap-3.5 rounded-3xl border p-5 sm:p-6" role="img" aria-label={`${h.chat.encabezado}: ${h.chat.aviso.texto}`}>
        <div class="border-marino-borde flex items-center justify-between border-b pb-3" aria-hidden="true">
          <div class="flex flex-col gap-0.5">
            <span class="text-[15px] font-semibold">{h.chat.encabezado}</span>
            <span class="text-sobre-marino-3 text-[12px]">{h.chat.sub}</span>
          </div>
          <span class="text-sobre-marino-3 font-mono text-[12px]">{h.chat.hoy}</span>
        </div>
        {h.chat.mensajes.map((m) => (
          <div aria-hidden="true" class:list={[burbuja, m.lado === 'yo' ? 'self-end rounded-[14px_14px_4px_14px] bg-[#2B4A74]' : 'self-start rounded-[14px_14px_14px_4px] bg-[#24334A]']}>
            {m.texto} <span class:list={[hora, m.lado === 'yo' && 'text-[#B7C3D4]']}>{m.hora}</span>
          </div>
        ))}
        <div aria-hidden="true" class="flex items-center gap-2 self-center rounded-full bg-[#3A2A26] px-3 py-1.5 text-[13px] font-medium text-[#F6B79A]">
          <Icono nombre="telefono" tamano={14} grosor={2} />
          {h.chat.llamadas}
        </div>
        {h.chat.mensajesDespues.map((m) => (
          <div aria-hidden="true" class:list={[burbuja, 'self-start rounded-[14px_14px_14px_4px] bg-[#24334A]']}>
            {m.texto} <span class={hora}>{m.hora}</span>
          </div>
        ))}
        <div aria-hidden="true" class="text-texto mt-1.5 flex items-start gap-3 rounded-[14px] bg-white p-3.5">
          <Simbolo alto={22} tono="claro" clase="mt-0.5" />
          <div class="flex flex-col gap-1">
            <span class="text-[13px] font-bold">{h.chat.aviso.quien}</span>
            <span class="text-[14px] leading-[1.45]">{h.chat.aviso.texto}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Mover la carga es la parte fácil (revision-22 §2) -->
<section class="bg-fondo">
  <div class="contenedor flex flex-col gap-10 py-16 lg:gap-14 lg:py-[120px]">
    <div class="flex max-w-[900px] flex-col gap-3">
      <h2 class="font-titulo text-marino m-0 text-[36px] leading-[1.1] font-bold lg:text-[52px]">{t.dolor.titulo}</h2>
      <p class="font-titulo text-apagado m-0 text-[19px] leading-[1.4] font-semibold lg:text-[24px]">{t.dolor.subtitulo}</p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      {t.dolor.tarjetas.map((c) => (
        <div class="border-borde flex flex-col gap-3 rounded-2xl border bg-white p-6 lg:p-7">
          <Icono nombre={c.icono} color="#B4530F" />
          <h3 class="font-titulo text-marino m-0 text-[20px] leading-[1.3] font-semibold lg:text-[22px]">{c.titulo}</h3>
          <p class="text-apagado m-0 text-[16px] leading-normal">{c.texto}</p>
        </div>
      ))}
    </div>
    <div class="flex items-start gap-6 pt-4 lg:items-center">
      <div class="bg-naranja mt-3 h-1.5 w-12 shrink-0 rounded-[3px] lg:mt-0 lg:w-16"></div>
      <p class="font-titulo text-marino m-0 text-[22px] leading-[1.3] font-bold lg:text-[32px]">{t.dolor.cierre[0]}<br />{t.dolor.cierre[1]}</p>
    </div>
  </div>
</section>

<!-- Dos formas -->
<section class="bg-white">
  <div class="contenedor flex flex-col gap-10 py-16 lg:gap-14 lg:py-28">
    <div class="flex max-w-[900px] flex-col gap-4">
      <div class="etiqueta text-naranja-texto text-[13px] lg:text-[14px]">{t.dosFormas.etiqueta}</div>
      <h2 class="font-titulo text-marino m-0 text-[32px] leading-[1.12] font-bold lg:text-[48px]">{t.dosFormas.titulo}</h2>
      <p class="text-texto-2 m-0 text-[18px] leading-[1.55] lg:text-[19px]">{t.dosFormas.bajada}</p>
    </div>
    <div class="grid gap-6 lg:grid-cols-2 lg:gap-8">
      <div class="bg-fondo border-borde flex flex-col gap-5 rounded-[20px] border p-6 lg:p-9">
        <div class="flex items-baseline gap-3"><span class="font-titulo text-critico text-[24px] font-bold">{t.dosFormas.reactivo.titulo}</span><span class="text-apagado text-[13px] font-bold tracking-[0.1em]">{t.dosFormas.reactivo.tipo}</span></div>
        <div class="flex flex-col gap-2.5">
          <span class="text-apagado text-[13px] font-semibold">{t.dosFormas.reactivo.mensajeEtiqueta}</span>
          <div class="rounded-xl bg-white px-4.5 py-4 text-[16px] leading-normal">{t.dosFormas.reactivo.mensaje}</div>
        </div>
        <div class="flex flex-col gap-2">
          <span class="text-apagado text-[13px] font-semibold">{t.dosFormas.reactivo.sigueEtiqueta}</span>
          <ul class="m-0 flex list-none flex-col gap-2 p-0 text-[15px] leading-[1.45]">
            {t.dosFormas.reactivo.pasos.map((p) => <li>{p}</li>)}
            <li class="text-critico font-semibold">{t.dosFormas.reactivo.final}</li>
          </ul>
        </div>
        <p class="border-borde text-texto-2 m-0 border-t pt-4 text-[16px] leading-[1.55]">{t.dosFormas.reactivo.cierre}</p>
      </div>
      <div class="bg-marino flex flex-col gap-5 rounded-[20px] p-6 text-white lg:p-9">
        <div class="flex items-baseline gap-3"><span class="font-titulo text-naranja text-[24px] font-bold">{t.dosFormas.proactivo.titulo}</span><span class="text-sobre-marino-2 text-[13px] font-bold tracking-[0.1em]">{t.dosFormas.proactivo.tipo}</span></div>
        <div class="flex flex-col gap-2.5">
          <span class="text-sobre-marino-2 text-[13px] font-semibold">{t.dosFormas.proactivo.mensajeEtiqueta}</span>
          <div class="bg-marino-2 border-marino-borde rounded-xl border px-4.5 py-4 text-[16px] leading-[1.55]">{t.dosFormas.proactivo.mensaje}</div>
        </div>
        <div class="flex flex-col gap-2">
          <span class="text-sobre-marino-2 text-[13px] font-semibold">{t.dosFormas.proactivo.sigueEtiqueta}</span>
          <ul class="m-0 flex list-none flex-col gap-2 p-0 text-[15px] leading-[1.45]">
            {t.dosFormas.proactivo.pasos.map((p) => <li>{p}</li>)}
            <li class="text-naranja font-semibold">{t.dosFormas.proactivo.final}</li>
          </ul>
        </div>
        <p class="border-marino-borde text-sobre-marino m-0 border-t pt-4 text-[16px] leading-[1.55]">{t.dosFormas.proactivo.cierre}</p>
      </div>
    </div>
  </div>
</section>

<!-- Así se ve Avanza -->
<section id={h.anclaComoFunciona} class="bg-marino scroll-mt-4 text-white">
  <div class="contenedor flex flex-col gap-10 py-16 lg:gap-14 lg:py-28">
    <div class="flex max-w-[900px] flex-col gap-3.5">
      <div class="etiqueta text-naranja text-[13px] lg:text-[14px]">{t.asiSeVe.etiqueta}</div>
      <h2 class="font-titulo m-0 text-[30px] leading-[1.12] font-bold lg:text-[48px]">{t.asiSeVe.titulo}</h2>
    </div>
    <div class="grid items-center gap-8 lg:grid-cols-[1fr_300px] lg:gap-10">
      <div class="text-texto flex flex-col gap-6 rounded-[20px] bg-white p-5 sm:p-8">
        <div class="flex flex-wrap items-center gap-3">
          <span class="font-mono text-[17px] font-medium">{t.asiSeVe.folio}</span>
          <span class="bg-suave text-marino rounded-full px-2.5 py-1 text-[13px] font-semibold">{t.asiSeVe.fase}</span>
          <span class="text-apagado flex-grow text-[15px]">{t.asiSeVe.trayecto}</span>
        </div>
        <ol class="m-0 grid list-none grid-cols-5 gap-2 p-0">
          {t.asiSeVe.fases.map((f, i) => (
            <li class="flex flex-col gap-2">
              <div class:list={['h-1.5 rounded-[3px]', i < 2 ? 'bg-exito-2' : i === 2 ? 'bg-naranja' : 'bg-borde']}></div>
              <span class:list={['text-[10px] leading-tight [overflow-wrap:anywhere] sm:text-[13px]', i < 2 ? 'text-exito font-semibold' : i === 2 ? 'text-marino font-bold' : 'text-apagado']}>{f}</span>
            </li>
          ))}
        </ol>
        <ul class="border-borde m-0 flex list-none flex-col border-t p-0">
          {t.asiSeVe.actividades.map((a, i) => (
            <li class:list={['flex items-center gap-3.5 py-3.5', i < t.asiSeVe.actividades.length - 1 && 'border-borde border-b', a.estado === 'ahora' && 'bg-naranja-suave -mx-3 rounded-lg px-3']}>
              {a.estado === 'hecha' && <span class="bg-exito-suave text-exito flex h-[22px] w-[22px] shrink-0 items-center justify-center rounded-full text-[13px] font-bold" aria-hidden="true">✓</span>}
              {a.estado === 'ahora' && <span class="bg-naranja text-marino flex h-[22px] w-[22px] shrink-0 items-center justify-center rounded-full text-[13px] font-bold" aria-hidden="true">!</span>}
              {a.estado === 'pendiente' && <span class="h-[22px] w-[22px] shrink-0 rounded-full border-2 border-[#C3C9D3]" aria-hidden="true"></span>}
              <span class:list={['flex-grow text-[15px] sm:text-[16px]', a.estado === 'ahora' && 'font-semibold', a.estado === 'pendiente' && 'text-apagado']}>{a.texto}</span>
              <span class:list={['text-right text-[13px] sm:text-[14px]', a.estado === 'ahora' ? 'text-naranja-hover font-semibold' : 'text-apagado']}>{a.detalle}</span>
            </li>
          ))}
        </ul>
      </div>
      <ul class="m-0 flex list-none flex-col gap-3.5 p-0">
        {t.asiSeVe.lado.map((l) => (
          <li class:list={['bg-marino-2 rounded-xl border px-4.5 py-3.5 text-[16px] font-semibold', l.tipo === 'alerta' ? 'border-naranja text-naranja' : 'border-marino-borde', l.tipo === 'espera' && 'text-sobre-marino']}>{l.texto}</li>
        ))}
      </ul>
    </div>
    <span class="text-sobre-marino-3 text-[14px]">{t.asiSeVe.maqueta}</span>
  </div>
</section>

<!-- Tres cosas -->
<section class="bg-fondo">
  <div class="contenedor flex flex-col gap-14 py-16 lg:gap-[72px] lg:py-28">
    <h2 class="font-titulo text-marino m-0 max-w-[760px] text-[32px] leading-[1.15] font-bold lg:text-[44px]">{t.tres.titulo}</h2>

    <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-[72px]">
      <div class="flex flex-col gap-4">
        <span class="text-naranja-texto font-mono text-[15px] font-medium">01</span>
        <h3 class="font-titulo text-marino m-0 text-[28px] leading-[1.2] font-bold lg:text-[36px]">{t.tres.uno.titulo}</h3>
        <p class="text-texto-2 m-0 text-[17px] leading-relaxed lg:text-[18px]">{t.tres.uno.texto}</p>
        <span class="text-apagado font-mono text-[13px] lg:text-[14px]">{t.tres.uno.fases}</span>
      </div>
      <div class="border-borde flex flex-col gap-4 rounded-[20px] border bg-white p-5 sm:p-7" aria-hidden="true">
        <div class="border-naranja flex flex-col gap-2.5 rounded-[14px] border-2 p-5">
          <span class="text-naranja-texto text-[12px] font-bold tracking-[0.12em]">{t.tres.uno.ahora}</span>
          <span class="text-[18px] font-semibold">{t.tres.uno.actividad}</span>
          <div class="flex flex-wrap items-center gap-2">
            <span class="bg-critico-suave text-critico rounded-full px-2.5 py-1 text-[13px] font-semibold">{t.tres.uno.vencida}</span>
            <span class="text-apagado text-[14px]">{t.tres.uno.responde}</span>
          </div>
          <div class="flex flex-wrap gap-2.5 pt-1">
            <span class="bg-marino flex h-10 items-center rounded-lg px-4 text-[14px] font-semibold text-white">{t.tres.uno.copiar}</span>
            <span class="border-borde text-texto flex h-10 items-center rounded-lg border bg-white px-4 text-[14px] font-semibold">{t.tres.uno.marcar}</span>
          </div>
        </div>
        <span class="text-apagado text-[14px]">{t.tres.uno.luego}</span>
      </div>
    </div>

    <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-[72px]">
      <div class="order-2 lg:order-1 border-borde flex flex-col gap-4 rounded-[20px] border bg-white p-5 sm:p-7" aria-hidden="true">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class="text-[15px] font-semibold">{t.tres.dos.tarjeta}</span>
          <span class="bg-exito-suave text-exito rounded-full px-2.5 py-1 text-[13px] font-semibold">{t.tres.dos.confirmado}</span>
        </div>
        <div class="bg-fondo text-texto rounded-xl p-4.5 text-[15px] leading-[1.6]">{t.tres.dos.mensaje} <span class="text-naranja-texto font-semibold">{t.tres.dos.enlace}</span></div>
        <div class="flex flex-wrap gap-2.5">
          <span class="bg-marino flex h-10 items-center rounded-lg px-4 text-[14px] font-semibold text-white">{t.tres.dos.botones[0]}</span>
          <span class="border-borde flex h-10 items-center rounded-lg border bg-white px-4 text-[14px] font-semibold">{t.tres.dos.botones[1]}</span>
          <span class="border-borde flex h-10 items-center rounded-lg border bg-white px-4 text-[14px] font-semibold">{t.tres.dos.botones[2]}</span>
        </div>
      </div>
      <div class="order-1 lg:order-2 flex flex-col gap-4">
        <span class="text-naranja-texto font-mono text-[15px] font-medium">02</span>
        <h3 class="font-titulo text-marino m-0 text-[28px] leading-[1.2] font-bold lg:text-[36px]">{t.tres.dos.titulo}</h3>
        <p class="text-texto-2 m-0 text-[17px] leading-relaxed lg:text-[18px]">{t.tres.dos.texto}</p>
        <span class="text-marino text-[18px] font-bold">{t.tres.dos.remate}</span>
      </div>
    </div>

    <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-[72px]">
      <div class="flex flex-col gap-4">
        <span class="text-naranja-texto font-mono text-[15px] font-medium">03</span>
        <h3 class="font-titulo text-marino m-0 text-[28px] leading-[1.2] font-bold lg:text-[36px]">{t.tres.tres.titulo}</h3>
        <p class="text-texto-2 m-0 text-[17px] leading-relaxed lg:text-[18px]">{t.tres.tres.texto}</p>
        <p class="border-naranja font-titulo text-marino m-0 border-l-4 pl-5 text-[20px] leading-[1.4] font-semibold lg:text-[22px]">{t.tres.tres.cita}</p>
      </div>
      <div class="border-borde flex flex-col gap-3.5 rounded-[20px] border bg-white p-5 sm:p-7">
        <div class="flex flex-col gap-1"><span class="text-apagado text-[13px] font-semibold tracking-[0.1em]">{t.tres.tres.rutaEtiqueta}</span><span class="text-[18px] font-semibold">{t.tres.tres.ruta}</span></div>
        <ul class="m-0 flex list-none flex-col gap-3.5 p-0">
          {t.tres.tres.pasos.map((p) => (
            <li class="bg-fondo flex items-center gap-3 rounded-[10px] px-4 py-3.5"><span class="bg-marino h-2 w-2 shrink-0 rounded-full" aria-hidden="true"></span><span class="flex-grow text-[15px]">{p.texto}</span><span class="text-apagado text-[13px]">{p.fase}</span></li>
          ))}
        </ul>
        <span class="text-exito text-[14px] font-semibold">{t.tres.tres.nota}</span>
      </div>
    </div>
  </div>
</section>

<!-- Antes / con Avanza -->
<section class="bg-white">
  <div class="contenedor flex flex-col gap-10 py-16 lg:py-28">
    <h2 class="font-titulo text-marino m-0 max-w-[760px] text-[32px] leading-[1.15] font-bold lg:text-[44px]">{t.antes.titulo}</h2>
    <table class="w-full border-collapse text-left">
      <thead>
        <tr class="border-marino border-b-2 text-[13px] font-bold tracking-[0.12em] lg:text-[14px]">
          <th scope="col" class="text-apagado w-1/2 pr-4 pb-3.5 lg:pr-12">{t.antes.antes}</th>
          <th scope="col" class="text-naranja-texto w-1/2 pb-3.5">{t.antes.con}</th>
        </tr>
      </thead>
      <tbody>
        {t.antes.filas.map(([a, b]) => (
          <tr class="border-borde border-b text-[16px] lg:text-[18px]">
            <td class="text-apagado py-4 pr-4 align-top lg:py-5 lg:pr-12">{a}</td>
            <td class="text-marino py-4 align-top font-semibold lg:py-5">{b}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<!-- Para quién -->
<section class="bg-fondo">
  <div class="contenedor flex flex-col gap-10 py-16 lg:gap-12 lg:py-28">
    <h2 class="font-titulo text-marino m-0 text-[32px] leading-[1.15] font-bold lg:text-[44px]">{t.paraTi.titulo}</h2>
    <div class="grid gap-4 md:grid-cols-3 lg:gap-6">
      {t.paraTi.perfiles.map((p) => (
        <div class="border-borde flex flex-col gap-3.5 rounded-2xl border bg-white p-6 lg:p-8">
          <Icono nombre={p.icono} tamano={36} color="#0F1B2D" grosor={1.6} />
          <h3 class="font-titulo text-marino m-0 text-[22px] font-semibold">{p.titulo}</h3>
          <p class="text-texto-2 m-0 text-[16px] leading-relaxed">{p.texto}</p>
          <span class="text-marino text-[18px] font-bold">{p.remate}</span>
          <a href={ruta(p.clave, idioma)} class="text-[15px] font-semibold">{p.enlace}</a>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Empieza -->
<section class="bg-fondo">
  <div class="contenedor pb-16 lg:pt-6 lg:pb-28">
    <div class="bg-naranja text-marino grid items-center gap-8 rounded-[28px] p-6 sm:p-10 lg:grid-cols-2 lg:gap-12 lg:p-16">
      <div class="flex flex-col gap-4">
        <h2 class="font-titulo m-0 text-[32px] leading-[1.15] font-bold lg:text-[44px]">{t.empieza.titulo}</h2>
        <div class="flex flex-col gap-1.5 text-[18px] leading-normal font-medium lg:text-[19px]">
          {t.empieza.lineas.map((l) => <span>{l}</span>)}
        </div>
      </div>
      <div class="flex flex-col gap-4 rounded-[20px] bg-white p-6 lg:p-8">
        <span class="text-apagado text-[14px] font-bold tracking-[0.12em]">{t.empieza.etiqueta}</span>
        <span class="font-titulo text-[32px] leading-[1.1] font-bold lg:text-[40px]">{t.empieza.gratis}</span>
        <span class="text-[17px] leading-normal">{t.empieza.ilimitados}</span>
        <a href={empezar} class="boton bg-marino h-14 text-[17px] text-white hover:text-white">{t.empieza.crear}</a>
        {t.empieza.planes.length > 0 && (
          <div class="border-borde flex flex-col gap-2.5 border-t pt-3 text-[15px] leading-[1.4]">
            {t.empieza.planes.map((p) => (
              <div class="flex justify-between gap-4"><span class="font-bold">{p.nombre}</span><span class="text-texto-2 text-right">{p.texto}</span></div>
            ))}
          </div>
        )}
        <a href={ruta('precios', idioma)} class="text-[15px] font-semibold">{t.empieza.verPlanes}</a>
      </div>
    </div>
  </div>
</section>

