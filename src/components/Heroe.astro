---
/**
 * Encabezado marino de las páginas interiores (Producto, Soluciones, Precios, Nosotros): etiqueta, el h1 que responde la
 * pregunta de la página en una frase, la bajada y el botón de la demo. A la derecha, lo que la página ponga en el slot.
 */
import { COMUN } from '../i18n/comun';
import { urlDemo, type Idioma } from '../i18n/rutas';
interface Props {
  idioma: Idioma;
  etiqueta: string;
  titulo: string;
  bajada: string;
  /** Sin botón (la página de la demo ya es el destino). */
  sinBoton?: boolean;
}
const { idioma, etiqueta, titulo, bajada, sinBoton = false } = Astro.props;
const t = COMUN[idioma];
const conLado = Astro.slots.has('default');
---
<section class="bg-marino text-white">
  <div class:list={['contenedor grid items-center gap-10 pt-8 pb-14 lg:gap-16 lg:py-20', conLado && 'lg:grid-cols-2']}>
    <div class="flex max-w-[760px] flex-col gap-5 lg:gap-6">
      <div class="etiqueta text-naranja text-[13px] lg:text-[14px]">{etiqueta}</div>
      <h1 class="font-titulo m-0 text-[34px] leading-[1.1] font-bold tracking-[-0.02em] sm:text-[44px] lg:text-[52px]">{titulo}</h1>
      <p class="text-sobre-marino m-0 text-[18px] leading-[1.55] lg:text-[20px]">{bajada}</p>
      {!sinBoton && (
        <div class="flex flex-col gap-3">
          <a href={urlDemo(idioma)} class="boton boton-principal h-14 self-start px-7 text-[17px]">{t.demo}</a>
          <span class="text-sobre-marino-2 text-[14px]">{t.bandaNota}</span>
        </div>
      )}
    </div>
    {conLado && <div class="flex justify-center"><slot /></div>}
  </div>
</section>
