---
/**
 * Soluciones, el índice (disenos/Soluciones.dc.html): los cuatro perfiles (revision-20 §4 suma "transportista y broker")
 * y "por dónde operas". Sin las líneas de precio del diseño (§6) y, por ahora, sin enlaces a las páginas por región ni a
 * los corredores: no existen, y un corredor no se publica sin datos verificados (CLAUDE.md del sitio).
 */
import Heroe from './Heroe.astro';
import { ruta, type Idioma } from '../i18n/rutas';
import { SOLUCIONES } from '../i18n/soluciones';
interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const t = SOLUCIONES[idioma].indice;
---
<Heroe idioma={idioma} etiqueta={t.etiqueta} titulo={t.titulo} bajada={t.bajada} />
<section class="bg-fondo">
  <div class="contenedor flex flex-col gap-8 py-16 lg:py-24">
    <h2 class="font-titulo text-marino m-0 text-[28px] font-bold lg:text-[36px]">{t.porLoQueHaces}</h2>
    <div class="grid gap-4 md:grid-cols-2 lg:gap-6">
      {t.perfiles.map((p) => (
        <a href={ruta(p.clave, idioma)} class="border-borde group flex flex-col gap-3 rounded-2xl border bg-white p-6 text-inherit no-underline hover:border-[#C3C9D3] lg:p-8">
          <span class="text-naranja-texto text-[13px] font-bold tracking-[0.12em]">{p.etiqueta}</span>
          <span class="font-titulo text-marino text-[22px] leading-[1.25] font-semibold lg:text-[26px]">{p.titulo}</span>
          <span class="text-texto-2 text-[16px] leading-relaxed">{p.texto}</span>
          <span class="text-naranja-texto mt-1 text-[15px] font-semibold group-hover:underline">{p.enlace}</span>
        </a>
      ))}
    </div>
  </div>
</section>
<section class="bg-white">
  <div class="contenedor flex flex-col gap-8 py-16 lg:py-24">
    <div class="flex flex-col gap-3">
      <h2 class="font-titulo text-marino m-0 text-[28px] font-bold lg:text-[36px]">{t.porDonde.titulo}</h2>
      <p class="text-texto-2 m-0 text-[17px]">{t.porDonde.bajada}</p>
    </div>
    <div class="grid gap-4 md:grid-cols-3 lg:gap-6">
      {t.porDonde.casos.map((c) => (
        <div class="bg-fondo flex flex-col gap-2 rounded-2xl p-6">
          <h3 class="font-titulo text-marino m-0 text-[20px] font-semibold">{c.titulo}</h3>
          <p class="text-texto-2 m-0 text-[16px] leading-relaxed">{c.texto}</p>
        </div>
      ))}
    </div>
  </div>
</section>
